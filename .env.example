SUPABASE_URL=
SUPABASE_KEY=
SLACK_WEBHOOK_URL=
SECRET_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD=
TRUST_FORWARDED_FOR=false
# 관리자 세션 최대 수명(시간) — 로그인 시각부터 센다(guide37)
ADMIN_SESSION_MAX_HOURS=8
# 관리자 계정 단위 잠금(guide38): IP와 무관하게 한 관리자 아이디가 이 창(초) 안에 이 횟수를 넘게 실패하면 5분 잠금
ADMIN_ACCOUNT_FAILURE_THRESHOLD=8
ADMIN_ACCOUNT_DETECTION_WINDOW_SECONDS=900
VERCEL_AUTOMATION_BYPASS_SECRET=

# scripts/management/daily_report.py --ai 옵션의 AI 보안 총평 + Track A(guide31) LLM
# 조기 경보 판단(soar.consider_early_warning)에서 Groq API를 호출할 때 사용.
# https://console.groq.com 에서 카드 등록 없이 무료로 발급받을 수 있다.
# 비워두면 두 기능 모두 조용히 건너뛰고, 나머지 기능은 그대로 동작한다.
GROQ_API_KEY=

# ----------------------------------------------------------------------------
# 영구 잠금 + 이메일 복구 (guide33 / guide34-a)
# ----------------------------------------------------------------------------
# 같은 IP/계정이 PERMANENT_LOCK_STRIKE_WINDOW_DAYS일 안에 N번째로 잠기면 영구 잠금으로 승격
PERMANENT_LOCK_STRIKE_COUNT=2
PERMANENT_LOCK_ACCOUNT_STRIKE_COUNT=2
PERMANENT_LOCK_STRIKE_WINDOW_DAYS=30
# HIGH 사건: false=관리자 승인 대기(권장), true=자동 영구 잠금
PERMANENT_LOCK_AUTO_ON_HIGH=false
# 영구 잠금 이벤트가 붙은 사건을 자동으로 CLOSED 처리할지(기본 false: 관리자가 직접 해결)
PERMANENT_LOCK_AUTO_CLOSE_INCIDENT=false
# 절대 영구 잠그지 않을 IP(쉼표로 구분). 관리자 PC IP를 꼭 넣어두세요.
PERMANENT_LOCK_IP_ALLOWLIST=127.0.0.1,::1
# IPv6를 몇 비트 대역 단위로 세고 잠글지(guide42). 허용 목록에는 IPv6 전체 주소를 적어도 같은 대역이면 인정된다
IPV6_PREFIX_LENGTH=64
# 복구 링크의 기준 주소(Host 헤더를 쓰지 않음)
PUBLIC_BASE_URL=http://127.0.0.1:5000
# 메일: console(개발 전용, 터미널에 출력) 또는 smtp
MAIL_BACKEND=console
# Mailpit(docker-compose.mailpit.yml)용 예시:
#   MAIL_BACKEND=smtp / SMTP_HOST=127.0.0.1 / SMTP_PORT=1025 / SMTP_STARTTLS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# 포트 465(처음부터 TLS)를 쓸 때만 true (이 경우 SMTP_STARTTLS는 무시됨)
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=6
# 발신 주소 — Gmail은 SMTP_USER와 같은 주소여야 합니다. "이름 <주소>" 형식도 가능
MAIL_FROM=login-watchdog@localhost
# 비밀번호 찾기(guide41): 회원당 하루 한도, IP당 시간당 한도, 요청·재설정 제출 IP당 분당 한도
PASSWORD_RESET_MAX_PER_DAY=3
PASSWORD_RESET_MAX_PER_IP_PER_HOUR=5
PASSWORD_RESET_RATE_LIMIT_PER_MINUTE=10
# 이메일 인증·변경 확인 링크(guide40): 유효시간(분), 재발송 간격(초), 회원·용도별 하루 한도, 확인 제출 IP당 분당 한도
EMAIL_TOKEN_TTL_MINUTES=15
EMAIL_TOKEN_COOLDOWN_SECONDS=60
EMAIL_TOKEN_MAX_PER_DAY=5
EMAIL_CONFIRM_RATE_LIMIT_PER_MINUTE=10
# 복구 요청 응답 고정 시간(초)과 백그라운드 처리 여부 — Vercel(서버리스)에서는 BACKGROUND_WORK를 false로 두세요
RECOVERY_MIN_RESPONSE_SECONDS=5
RECOVERY_BACKGROUND_WORK=false
# /recovery/verify 제출의 IP당 분당 한도(guide37)
RECOVERY_VERIFY_RATE_LIMIT_PER_MINUTE=10
# /recovery/request 요청의 IP당 분당 한도(guide43) — 넘기면 고정 대기 없이 바로 429
RECOVERY_REQUEST_RATE_LIMIT_PER_MINUTE=5
# 대시보드 상태 조회가 만료된 잠금 정리를 다시 하기까지의 최소 간격(초, guide46). 0이면 매 갱신마다
ADMIN_STATUS_RELEASE_INTERVAL_SECONDS=15

# === Track D === 네트워크 계층 탐지·차단(로컬 Docker 단지 전용). 이름·뜻은 docs/track-d/contracts.md K1
# Vercel에는 아래 값을 넣지 않는다 — 비어 있으면 Track D 기능이 꺼진 채로 기존 앱이 그대로 동작한다.
# 사람마다 다른 값(LW_EDGE_PREFIX, NET_EDGE_SUBNET, PERMANENT_LOCK_IP_ALLOWLIST, LW_NODE_NAME)은 팀 계획 01의 4장 표를 따른다.

# --- A ---
# 공격 연습 대역의 앞 세 자리 — 사람마다 바꾼다(A 172.28.11 / B 172.28.12 / C 172.28.13 / 발표 PC 172.28.0). Docker Compose가 읽는다
LW_EDGE_PREFIX=172.28.11
# Suricata·Scapy가 감시할 edge(공격이 들어오는 쪽) 인터페이스 이름. eth0/eth1 순서는 PC·재생성마다 다르다.
# 확인: docker run --rm --network container:login-watchdog-gateway nicolaka/netshoot ip -br addr → 172.30이 아닌 쪽.
# Scapy(l4-detector)는 auto이거나 이 이름에 edge 주소가 없으면 LW_EDGE_PREFIX.10이 붙은 쪽을 스스로 찾는다
SENSOR_IFACE=eth1

# --- B ---
# shipper → 앱 서명 키. 팀 Infisical에서 값을 꺼내 넣는다(메신저·AI 대화에 붙여 넣지 않는다). 비어 있으면 수집 API가 모든 요청을 거부
NET_INGEST_SECRET=
NET_INTERNAL_MAX_SKEW_SECONDS=60
NET_INGEST_MAX_BODY_BYTES=16384
NET_INGEST_RATE_LIMIT_PER_MINUTE=600
NET_CORRELATION_WINDOW_MINUTES=15
NET_FLOOD_WINDOW_MINUTES=5
NET_SUCCESS_LOGIN_LOOKBACK_MINUTES=30
NET_ROTATION_WINDOW_MINUTES=10
NET_SUBNET_MIN_IPS=3
NET_FLOOD_REPEAT_DAYS=30

# --- C ---
# fw-agent → 앱 서명 키. NET_INGEST_SECRET과 다른 값. 팀 Infisical에서 값을 꺼내 넣는다
NET_AGENT_SECRET=
# 이 주소(gateway의 core 쪽)에서 온 요청만 X-Forwarded-For를 믿는다. 비어 있으면 기존 동작
# Docker에서는 172.30.0.10(compose가 직접 넣으므로 비워 둬도 됨). 예전 값 172.29.0.10은 Docker Desktop 내부 대역과 겹쳐 쓰지 않는다
TRUSTED_PROXY_IPS=
# 이 PC가 맡는 공격 대역 — LW_EDGE_PREFIX와 맞춘다(예: 172.28.13.0/24). 비어 있으면 거르지 않음
NET_EDGE_SUBNET=
NET_BLOCK_DEFAULT_TTL_SECONDS=3600
NET_BLOCK_MAX_TTL_SECONDS=21600
NET_BLOCK_REPEAT_DAYS=30
SUSPICIOUS_LOGIN_MAIL_COOLDOWN_SECONDS=3600
FW_AGENT_STALE_SECONDS=30
SHIPPER_STALE_SECONDS=120
AGENT_ALERT_COOLDOWN_SECONDS=600
# 이 PC의 이름(A·B·C·demo). 비어 있으면 장비 정지 감시·알림을 하지 않음
LW_NODE_NAME=
