# Git
.git
.gitignore

# 비밀값과 로컬 환경설정
.env
.env.*
!.env.example

# Python 가상환경과 캐시
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 편집기 설정
.vscode/
.idea/

# 테스트 및 문서
tests/
docs/

# 로컬 로그와 임시 파일
*.log
*.tmp
tmp/
temp/

# Docker 관련 개발 파일
docker-compose*.yml
Dockerfile*

# Next.js 소스와 의존성 — 앱은 빌드 결과물(spa/, public/_next/)만 사용
web/

# AI 도구 설정·캐시와 CI 설정 — 개발 PC에서만 쓰고 앱 실행과 무관
.claude/
.agent-cache/
.github/

# netwatch/는 별도 컨테이너용(nginx.conf는 compose가 볼륨으로 직접 마운트)이라 앱 이미지에 필요 없다
netwatch/

# 설명 문서 — 앱이 실행 중에 읽지 않는다
*.md